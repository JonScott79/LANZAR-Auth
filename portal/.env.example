# LANZAR Portal Environment Configuration Example
# Copy to .env for local development

# Environment Mode: 'development' | 'staging' | 'production'
VITE_APP_ENV=development

# Firebase Project Configuration
# For local development: must be 'demo-lanzar-dev'
VITE_FIREBASE_PROJECT_ID=demo-lanzar-dev
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# LANZAR Ecosystem Endpoints
VITE_AUTH_API_BASE=http://localhost:4001
VITE_AUTH_HUB_URL=http://localhost:4000
VITE_PORTAL_URL=http://localhost:5173

# Firebase Web Client Configuration (Optional for emulator mode)
VITE_FIREBASE_API_KEY=fake-emulator-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost:9099
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=1:000000000000:web:emulator
VITE_FIREBASE_MEASUREMENT_ID=
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_sample
